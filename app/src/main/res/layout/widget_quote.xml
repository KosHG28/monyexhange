<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «Курс по чеку» (Pro): страна и сумма в местной валюте, крупно — рубли по лучшей карте, ниже — карта. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="12dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/widget_place"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/inter_tight_medium"
        android:maxLines="1"
        android:text="@string/widget_title"
        android:textColor="@color/widget_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_sum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_tight_light"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="@color/widget_ink"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/inter_tight_medium"
        android:maxLines="1"
        android:textColor="@color/widget_good"
        android:textSize="12.5sp" />
</LinearLayout>
